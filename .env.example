# ─────────────────────────────────────────────────────────────────────────────
# 막차 알리미 환경변수 목록
#
# 사용 방법:
#   cp .env.example .env
#   .env 파일에 실제 값 입력 후 사용
#
# ⚠️  .env 파일은 .gitignore에 포함됩니다 — 절대 커밋하지 마세요.
# 📖  자세한 설정 방법: /docs/env-guide.md 참고
# ─────────────────────────────────────────────────────────────────────────────

# ── Spring Profile ────────────────────────────────────────────────────────────
# local | prod
SPRING_PROFILES_ACTIVE=local

# ── Database (MySQL) ──────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=last_train_db
DB_USERNAME=
DB_PASSWORD=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=       # 운영 환경에서만 설정. 로컬은 빈 값 허용.

# ── JWT ───────────────────────────────────────────────────────────────────────
# 반드시 32자 이상의 무작위 문자열 사용
# 생성 방법: openssl rand -hex 32
JWT_SECRET=

# ── ODsay API (경로 탐색) ─────────────────────────────────────────────────────
# https://lab.odsay.com 에서 발급
# 반드시 Server 플랫폼 키 사용 (IP 기반 인증)
ODSAY_API_KEY=

# ── Kakao OAuth2.0 ────────────────────────────────────────────────────────────
# https://developers.kakao.com 에서 앱 생성 후 발급
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ── VAPID (Web Push 알림) ─────────────────────────────────────────────────────
# 키 생성 방법: npx web-push generate-vapid-keys
# ⚠️  VAPID_PRIVATE_KEY 유실 시 기존 구독 전체 무효화됨 — 안전한 장소 보관 필수
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── 운영 전용 ─────────────────────────────────────────────────────────────────
# SPRING_PROFILES_ACTIVE=prod 일 때만 필요
CORS_ALLOWED_ORIGINS=https://yourdomain.com
ADMIN_EMAIL=admin@example.com